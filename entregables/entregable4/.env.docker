# Configuración usada por docker-compose para el backend.
# No eliminar: docker-compose.yml carga este archivo con env_file.
APP_NAME=Sistema MYPE POS
APP_DEBUG=true

# Base de datos interna del servicio MySQL definido en docker-compose.yml.
DATABASE_URL=mysql+pymysql://inventario:inventario123@db:3306/sistemamype

# Seguridad y sesiones. Cambia JWT_SECRET_KEY antes de usarlo en producción.
JWT_SECRET_KEY=123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
SESSION_INACTIVITY_MINUTES=30
SESSION_HEARTBEAT_GRACE_MINUTES=2
SINGLE_ACTIVE_SESSION=true

# Recuperación de contraseña.
RESET_CODE_EXPIRE_MINUTES=3
RESET_CODE_RESEND_SECONDS=60
RESET_CODE_MAX_ATTEMPTS=5

# SMTP: queda desactivado por defecto para evitar envíos accidentales.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=codexventa@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Codex Venta
SMTP_USE_TLS=true
